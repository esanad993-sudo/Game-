// Turbo Rush Brain Edition — Prisma schema
// Question sets, live game rooms, homework, and submissions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuestionSet {
  id          String     @id @default(cuid())
  title       String
  subject     String     @default("General")
  gradeLevel  String     @default("all") // "middle" | "high" | "all"
  description String     @default("")
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]
  rooms       GameRoom[]
  homework    Homework[]
}

model Question {
  id          String       @id @default(cuid())
  setId       String
  set         QuestionSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  text        String
  // JSON-encoded string array of answer choices
  choices     String
  correctIdx  Int
  explanation String       @default("")
  order       Int          @default(0)
}

model GameRoom {
  id          String       @id @default(cuid())
  code        String       @unique
  setId       String
  set         QuestionSet  @relation(fields: [setId], references: [id])
  status      String       @default("lobby") // lobby | playing | ended
  mode        String       @default("slow")  // slow | heart
  createdAt   DateTime     @default(now())
  endedAt     DateTime?
  players     Player[]
}

model Player {
  id          String       @id @default(cuid())
  roomId      String
  room        GameRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name        String
  score       Int          @default(0)
  correct     Int          @default(0)
  wrong       Int          @default(0)
  bestStreak  Int          @default(0)
  coins       Int          @default(0)
  joinedAt    DateTime     @default(now())
  socketId    String?
  isHost      Boolean      @default(false)
}

model Homework {
  id          String       @id @default(cuid())
  setId       String
  set         QuestionSet  @relation(fields: [setId], references: [id])
  title       String
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  submissions Submission[]
}

model Submission {
  id          String       @id @default(cuid())
  homeworkId  String
  homework    Homework     @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  playerName  String
  score       Int
  correct     Int
  wrong       Int
  bestStreak  Int
  coins       Int
  mistakes    String       @default("[]") // JSON
  submittedAt DateTime     @default(now())
}
